# Stage 3 fault and arm parameters, sourced by run_one.sh.  Fault levels come from the
# calibration (tools/hog/calibrate.sh); see results/stage3/REPORT.md for the measured effect.
STOCK_COLLECTOR_IMAGE=10.10.1.1:30000/otelcol-pb-es-ctr:v20261119-180318
FAULT_MODE=spin                     # default for scenarios that set none; run_one.sh sets burn (saturated, cascade,
                                    # cold_start) or spin (noisy_neighbour, late_everywhere).  quota alone (docker update
                                    # CPU quota) cannot reach the needed levels: docker rejects quotas below 1000 us
FAULT_FOR=180                       # seconds (minutes 4-7; cold start 2-5)
FAULT_LEVEL_SOCIALGRAPH=40          # calib 2026-11-21 01:23: 40 threads -> socialgraph P95 x7.5, 28.8 % over-SLO requests (20 -> no effect)
FAULT_LEVEL_POST_STORAGE=80         # calib 2026-11-21 01:23: 80 threads -> post_storage P95 x6.4, 28.3 % over-SLO (40 -> x3.3, 11.4 %)
FAULT_LEVEL_ALL=6                   # calib3 calib-20261121-024139: 6 -> 6.4 % over-SLO, 7 -> 83.7 % (0 non-2xx); no thread
                                    # count reaches 20-30 %, so late_everywhere stays at 6 and is labelled "mild systemic"
FAULT_DUTY_ALL=
# Confined fault (saturated, cascade, cold_start; Stage 3 decision 2026-11-21): BURN_THREADS spinning threads inside the
# target container under a CPU limit on that container, BURN_LIMIT = quota_us/period_us (docker update), so the spinner
# cannot spill onto the node; sized so the target's own-time P95 is about 2 x its own-time share b (socialgraph b 5.30 ms,
# poststorage b 7.57 ms on the steady shadow).  noisy_neighbour (socialgraph, FAULT_LEVEL_SOCIALGRAPH unconfined spinner
# threads) is the saturated scenario as it ran before; late_everywhere keeps the unconfined spinner too.
BURN_THREADS_SOCIALGRAPH=1           # calib-20261121-224737: 1 thread, 0.33 CPU -> socialgraph own-time P95 10.8 ms = 1.97 b,
BURN_LIMIT_SOCIALGRAPH=3300/10000    # 27.3 % over-SLO, 0 non-2xx, node-2 services' own-time P95 0.94-1.03 x base (0.5 CPU: 1.68 b)
BURN_THREADS_POST_STORAGE=1          # calib-20261121-230650: 1 thread, 0.39 CPU -> poststorage own-time P95 17.3 ms = 2.16 b,
BURN_LIMIT_POST_STORAGE=3900/10000   # 12.0 % over-SLO, 0 non-2xx, node-3 services 0.98-1.02 x base (0.43 CPU: 1.43 b, 0.33: 2.35 b)
BURST_FOR=60                        # bursty: 3x load (+200 req/s) for 60 s from minute 6
BURST_RPS=200
TAIL_WAIT=5s                        # tail_sampling decision_wait
RESERVOIR_SHARES='{"node-1": 0.47, "node-2": 0.30, "node-3": 0.23}'
